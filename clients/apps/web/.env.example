# Development values for the web app. dev/setup-environment copies this
# file to .env.local, which is never committed.
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_FRONTEND_BASE_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_ENVIRONMENT="development"
# Error-reporting DSN for the browser bundle; empty means off.
NEXT_PUBLIC_SENTRY_DSN=""
# The server-side rendering reaches the API here (defaults to the public URL).
OUTCEPTION_API_URL="http://127.0.0.1:8000"
