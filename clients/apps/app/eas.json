{
  "cli": {
    "version": ">= 16.2.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_OUTCEPTION_SERVER_URL": "https://api.outception.com",
        "EXPO_PUBLIC_OUTCEPTION_WEB_URL": "https://outception.com"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      },
      "channel": "simulator",
      "extends": "development"
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_OUTCEPTION_SERVER_URL": "https://api.outception.com",
        "EXPO_PUBLIC_OUTCEPTION_WEB_URL": "https://outception.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_OUTCEPTION_SERVER_URL": "https://api.outception.com",
        "EXPO_PUBLIC_OUTCEPTION_WEB_URL": "https://outception.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6793827093"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "alpha"
      }
    }
  }
}
