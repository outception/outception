# Values for a development build of the app. Copy to .env, which is never
# committed; the build profiles in eas.json carry the production values.
EXPO_PUBLIC_OUTCEPTION_SERVER_URL=http://127.0.0.1:8000
EXPO_PUBLIC_OUTCEPTION_WEB_URL=http://127.0.0.1:3000
# The public OAuth client registered on the server for the app.
EXPO_PUBLIC_OAUTH_CLIENT_ID=
# Error reporting; empty means off.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
