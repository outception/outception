# =============================================================================
# Outception - production environment (one host, the edge in front)
# Copy to `deploy/.env.prod` and fill in. NEVER commit the filled-in file.
#   cp deploy/.env.prod.example deploy/.env.prod
# Backend settings are prefixed OUTCEPTION_. See server/outception/config.py.
# =============================================================================

# --- Domains (used by Caddy + cookie/CORS settings below) --------------------
# The public site and the API hostname. Both must be DNS records on Cloudflare
# pointing at this server's IP (proxied / orange-cloud is fine).
WEB_DOMAIN=outception.com
API_DOMAIN=api.outception.com

# Cloudflare API token with Zone:DNS:Edit on the zone - used by Caddy for
# automatic TLS via the DNS-01 challenge (works behind the orange cloud).
CF_API_TOKEN=

# Container image tag to run (the deploy workflow sets this to the git SHA).
IMAGE_TAG=latest

# --- Web bundle (baked in at build time; the deploy workflow passes them) ---
NEXT_PUBLIC_API_URL=https://api.outception.com
NEXT_PUBLIC_FRONTEND_BASE_URL=https://outception.com
NEXT_PUBLIC_ENVIRONMENT=production
# Error-reporting DSN for the browser bundle; empty = reporting off.
NEXT_PUBLIC_SENTRY_DSN=
# Emails allowed on the founder's review page (must match OUTCEPTION_ADMIN_EMAILS).
NEXT_PUBLIC_ADMIN_EMAILS=
# The web server reads the API over the internal network.
OUTCEPTION_API_URL=http://api:10000

# --- The engine profile (optional; docs/ENGINE.md) --------------------------
# Image and memory for `docker compose --profile engine`; the checkpoint is
# placed on the engine_models volume by hand. Leave as is to run without it.
ENGINE_IMAGE=ghcr.io/outception/engine:latest
ENGINE_MEMORY=4g

# --- The server contract (server/.env.prod.example, checked in CI) ----------

OUTCEPTION_ENV=production
OUTCEPTION_LOG_LEVEL=INFO
OUTCEPTION_WORKER_HEALTH_CHECK_INTERVAL=PT30S
OUTCEPTION_WORKER_MAX_RETRIES=20
OUTCEPTION_WORKER_MIN_BACKOFF_MILLISECONDS=2000
OUTCEPTION_WORKER_EVENT_LOOP_WATCHDOG_MAX_MISSES=3

# Prometheus remote write. Unset in production: the counters stay in the
# process registry and are exposed on the internal network only.
OUTCEPTION_GRAFANA_CLOUD_PROMETHEUS_WRITE_URL=
OUTCEPTION_GRAFANA_CLOUD_PROMETHEUS_WRITE_USERNAME=
OUTCEPTION_GRAFANA_CLOUD_PROMETHEUS_WRITE_PASSWORD=
OUTCEPTION_GRAFANA_CLOUD_PROMETHEUS_WRITE_INTERVAL=60
OUTCEPTION_WORKER_DEFAULT_DEBOUNCE_MIN_THRESHOLD=PT15S
OUTCEPTION_WORKER_DEFAULT_DEBOUNCE_MAX_THRESHOLD=PT900S

# Accounts (login, sessions, the OAuth2 provider, follows, server prefs).
# When false none of those routers are mounted: the endpoints do not
# exist, so they cannot be hit. Unset resolves per environment (see
# `_default_accounts_enabled`): on in development and testing so the
# suite keeps its auth coverage, off in the internet-facing environments
# until the deploy sets it. Readers never need an account; submitting a
# product to the daily card does.
OUTCEPTION_ACCOUNTS_ENABLED=

# Emails allowed on the founder's review pages (Products of the day).
OUTCEPTION_ADMIN_EMAILS=[]
OUTCEPTION_MEDIA_DIR=/data/media
OUTCEPTION_SECRET=
OUTCEPTION_HASH_SECRETS={}
OUTCEPTION_CURRENT_HASH_SECRET_ID=
OUTCEPTION_WWW_AUTHENTICATE_REALM=outception

# JSON list of accepted CORS origins
OUTCEPTION_CORS_ORIGINS='["https://outception.com"]'
OUTCEPTION_ALLOWED_HOSTS='["outception.com", "www.outception.com"]'

# Reverse proxies (by IP or CIDR) whose client-IP forwarding headers we
# trust. A request's peer IP must fall inside one of these ranges before a
# forwarding header is honoured; otherwise the header is ignored and the
# socket peer IP is used. Leave empty to never trust forwarding headers
# (correct when nothing sits in front of the app). In production set this
# to the reverse proxy or CDN edge that terminates inbound requests.
OUTCEPTION_TRUSTED_PROXY_IPS=[]

# Client-IP forwarding headers to honour (in priority order, first present
# wins) when the peer is a trusted proxy. Set this to match whatever the
# edge emits.
OUTCEPTION_TRUSTED_CLIENT_IP_HEADERS='["CF-Connecting-IP", "True-Client-IP"]'

# User-Agent sent by the outbound HTTP clients (feed fetches, reachability
# checks). The field name is kept for parity with the live env file.
OUTCEPTION_OUTCEPTION_USER_AGENT=Outception/1.0 (+https://outception.com)

# Base URL for the backend. Used by generate_external_url to
# generate URLs to the backend accessible from the outside.
OUTCEPTION_BASE_URL=http://127.0.0.1:8000

# URL to frontend app.
OUTCEPTION_FRONTEND_BASE_URL=http://127.0.0.1:3000
OUTCEPTION_FRONTEND_DEFAULT_RETURN_PATH=/

# Authentication session
OUTCEPTION_AUTHENTICATION_SESSION_TTL=PT900S
OUTCEPTION_AUTHENTICATION_SESSION_COOKIE_KEY=
OUTCEPTION_AUTHENTICATION_SESSION_COOKIE_DOMAIN=127.0.0.1

# Email OTP
OUTCEPTION_EMAIL_OTP_TTL=PT1800S
OUTCEPTION_EMAIL_OTP_CODE_LENGTH=6

# App Review bypass (for testing login flow during Apple/Google app reviews)
OUTCEPTION_APP_REVIEW_EMAIL=
OUTCEPTION_APP_REVIEW_OTP_CODE=

# OAuth2 session state
OUTCEPTION_OAUTH2_SESSION_STATE_TTL=PT600S
OUTCEPTION_OAUTH2_SESSION_STATE_COOKIE_KEY=
OUTCEPTION_OAUTH2_SESSION_STATE_COOKIE_DOMAIN=127.0.0.1

# User session
OUTCEPTION_USER_SESSION_TTL=PT2678400S
OUTCEPTION_USER_SESSION_FRESHNESS_TTL=PT3600S
OUTCEPTION_USER_SESSION_COOKIE_KEY=
OUTCEPTION_USER_SESSION_COOKIE_DOMAIN=127.0.0.1

# Email verification
OUTCEPTION_EMAIL_VERIFICATION_TTL_SECONDS=1800

# Database
OUTCEPTION_POSTGRES_USER=outception
OUTCEPTION_POSTGRES_PWD=
OUTCEPTION_POSTGRES_HOST=127.0.0.1
OUTCEPTION_POSTGRES_PORT=5432
OUTCEPTION_POSTGRES_HOST_FALLBACK=
OUTCEPTION_POSTGRES_PORT_FALLBACK=
OUTCEPTION_POSTGRES_DATABASE=outception
OUTCEPTION_POSTGRES_SSL=false
OUTCEPTION_DATABASE_POOL_SIZE=5
OUTCEPTION_DATABASE_SYNC_POOL_SIZE=1
OUTCEPTION_DATABASE_POOL_RECYCLE_SECONDS=600
OUTCEPTION_DATABASE_COMMAND_TIMEOUT_SECONDS=30.0
OUTCEPTION_DATABASE_CONNECT_TIMEOUT_SECONDS=10.0
OUTCEPTION_DATABASE_STREAM_YIELD_PER=100
OUTCEPTION_POSTGRES_READ_USER=
OUTCEPTION_POSTGRES_READ_PWD=
OUTCEPTION_POSTGRES_READ_HOST=
OUTCEPTION_POSTGRES_READ_PORT=
OUTCEPTION_POSTGRES_READ_HOST_FALLBACK=
OUTCEPTION_POSTGRES_READ_PORT_FALLBACK=
OUTCEPTION_POSTGRES_READ_DATABASE=

# Redis
OUTCEPTION_REDIS_HOST=127.0.0.1
OUTCEPTION_REDIS_PORT=6379
OUTCEPTION_REDIS_DB=0
OUTCEPTION_REDIS_USERNAME=
OUTCEPTION_REDIS_PASSWORD=
OUTCEPTION_EMAIL_SENDER=logger
OUTCEPTION_RESEND_API_KEY=
OUTCEPTION_RESEND_API_BASE_URL=https://api.resend.com
OUTCEPTION_EMAIL_SMTP_HOST=smtp.gmail.com
OUTCEPTION_EMAIL_SMTP_PORT=587
OUTCEPTION_EMAIL_SMTP_USER=
OUTCEPTION_EMAIL_SMTP_PASSWORD=
OUTCEPTION_EMAIL_SMTP_STARTTLS=true
OUTCEPTION_EMAIL_FROM_NAME=Outception
OUTCEPTION_EMAIL_FROM_DOMAIN=outception.com
OUTCEPTION_EMAIL_FROM_LOCAL=no-reply
OUTCEPTION_EMAIL_DEFAULT_REPLY_TO_NAME=Outception Support
OUTCEPTION_EMAIL_DEFAULT_REPLY_TO_EMAIL_ADDRESS=support@outception.com
OUTCEPTION_EMAIL_LOG_RETENTION_PERIOD=PT57024000S
OUTCEPTION_TURNSTILE_SECRET=

# Google
OUTCEPTION_GOOGLE_CLIENT_ID=
OUTCEPTION_GOOGLE_CLIENT_SECRET=

# Microsoft (common tenant, OpenID Connect)
OUTCEPTION_MICROSOFT_CLIENT_ID=
OUTCEPTION_MICROSOFT_CLIENT_SECRET=

# Apple. APPLE_KEY_VALUE is the "Sign in with Apple" .p8 private key, used
# to sign the ES256 client-secret JWT. See the validator below: CI ships
# it base64-encoded because an env file cannot carry the key's newlines.
OUTCEPTION_APPLE_CLIENT_ID=
OUTCEPTION_APPLE_TEAM_ID=
OUTCEPTION_APPLE_KEY_ID=
OUTCEPTION_APPLE_KEY_VALUE=
OUTCEPTION_APPLE_DOMAIN_ASSOCIATION=

# Summaries. The free lanes come first; the paid provider is the backup
# for summaries only. No key set means summaries are disabled.
OUTCEPTION_GEMINI_API_KEY=
OUTCEPTION_GEMINI_API_KEYS=
OUTCEPTION_GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
OUTCEPTION_GEMINI_RPM_CAP=12
OUTCEPTION_GROQ_API_KEY=
OUTCEPTION_GROQ_API_KEYS=
OUTCEPTION_GROQ_MODEL=openai/gpt-oss-120b
OUTCEPTION_GROQ_RPM_CAP=20
OUTCEPTION_MISTRAL_API_KEY=
OUTCEPTION_MISTRAL_API_KEYS=
OUTCEPTION_MISTRAL_MODEL=ministral-8b-latest
OUTCEPTION_MISTRAL_RPM_CAP=30
OUTCEPTION_NVIDIA_API_KEY=
OUTCEPTION_NVIDIA_API_KEYS=
OUTCEPTION_NVIDIA_MODEL=moonshotai/kimi-k3
OUTCEPTION_NVIDIA_RPM_CAP=30
OUTCEPTION_OLLAMA_API_KEY=
OUTCEPTION_OLLAMA_API_KEYS=
OUTCEPTION_OLLAMA_MODEL=gpt-oss:120b
OUTCEPTION_OLLAMA_RPM_CAP=20
OUTCEPTION_CLOUDFLARE_ACCOUNT_ID=
OUTCEPTION_CLOUDFLARE_AI_TOKEN=
OUTCEPTION_CLOUDFLARE_AI_TOKENS=
OUTCEPTION_CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
OUTCEPTION_CLOUDFLARE_RPM_CAP=20
OUTCEPTION_CLOUDFLARE_DAILY_CAP=150
OUTCEPTION_ANTHROPIC_API_KEY=
OUTCEPTION_SUMMARY_MODEL=claude-haiku-4-5-20251001
OUTCEPTION_SUMMARY_DAILY_CAP=5000
OUTCEPTION_SUMMARY_WARM_DAILY_CAP=3500
OUTCEPTION_SUMMARY_PRETAP_DAILY_CAP=400
OUTCEPTION_GNEWS_RESOLVE_ENABLED=true
OUTCEPTION_READER_FALLBACK_ENABLED=true
OUTCEPTION_JINA_API_KEY=
OUTCEPTION_FINNHUB_API_KEY=
OUTCEPTION_LAUNCH_LIBRARY_TOKEN=
OUTCEPTION_TRANSIT_KEY_NEWYORK=
OUTCEPTION_TRANSIT_KEY_DUBLIN=
OUTCEPTION_TRANSIT_KEY_SYDNEY=
OUTCEPTION_FOOTBALL_DATA_API_KEY=
OUTCEPTION_CRICKETDATA_API_KEY=
OUTCEPTION_LOGO_DEV_PUBLISHABLE_KEY=

# The model governor: every model call reserves against these caps and
# settles afterwards. Two lanes, interactive (readers) and background
# (warming, scoring, resolving), each with hourly and daily caps, a global
# hourly cap and a daily cap on the paid lane. LLM_DISABLED is the kill
# switch: summaries serve cached or teaser text and scoring pauses.
OUTCEPTION_LLM_DISABLED=false
OUTCEPTION_LLM_INTERACTIVE_HOURLY_CAP=600
OUTCEPTION_LLM_INTERACTIVE_DAILY_CAP=5000
OUTCEPTION_LLM_BACKGROUND_HOURLY_CAP=400
OUTCEPTION_LLM_BACKGROUND_DAILY_CAP=5000
OUTCEPTION_LLM_GLOBAL_HOURLY_CAP=900
OUTCEPTION_LLM_PAID_DAILY_CAP=50
OUTCEPTION_LLM_BACKGROUND_SUBCAP_WARM=3500
OUTCEPTION_LLM_BACKGROUND_SUBCAP_SCORE=1000
OUTCEPTION_LLM_BACKGROUND_SUBCAP_RESOLVE=500

# The house decision model: a typed decision engine served from its own
# container. Unset means every decision chain ends at the LLM rendering.
OUTCEPTION_ENGINE_URL=
OUTCEPTION_ENGINE_API_KEY=
OUTCEPTION_ENGINE_TIMEOUT_S=2.0
OUTCEPTION_DECISION_CHAIN_SCORE=llm_decider
OUTCEPTION_DECISION_CHAIN_CATEGORY=llm_decider
OUTCEPTION_DECISION_CHAIN_ROUTE=llm_decider
OUTCEPTION_DECISION_CHAIN_RESOLVE=llm_decider
OUTCEPTION_DECISION_SHADOW=false
OUTCEPTION_OWN_GENERATION_URL=
OUTCEPTION_OWN_GENERATION_MODEL=
OUTCEPTION_OWN_GENERATION_API_KEY=

# Briefings
OUTCEPTION_BRIEFING_ENABLED=false
OUTCEPTION_BRIEFING_PROFILES=[]
OUTCEPTION_BRIEFING_BUILD_CRON=0 5 * * *

# Feedback digest and push notifications
OUTCEPTION_FEEDBACK_DIGEST_EMAIL=
OUTCEPTION_WEB_PUSH_VAPID_PUBLIC_KEY=
OUTCEPTION_WEB_PUSH_VAPID_PRIVATE_KEY=
OUTCEPTION_WEB_PUSH_SUBJECT=

# Sentry
OUTCEPTION_SENTRY_DSN=

# Memory Profiling
OUTCEPTION_MEMORY_PROFILE_ENABLED=false
OUTCEPTION_MEMORY_PROFILE_INTERVAL=300
OUTCEPTION_MEMORY_PROFILE_S3_BUCKET_NAME=

# Logfire
OUTCEPTION_LOGFIRE_TOKEN=
OUTCEPTION_LOGFIRE_IGNORED_ACTORS=[]
OUTCEPTION_S3_LOGS_BUCKET_NAME=

# AWS (logs and backups only)
OUTCEPTION_AWS_ACCESS_KEY_ID=
OUTCEPTION_AWS_SECRET_ACCESS_KEY=
OUTCEPTION_AWS_REGION=us-east-2
OUTCEPTION_AWS_SIGNATURE_VERSION=v4
OUTCEPTION_AWS_S3_CONNECT_TIMEOUT_SECONDS=5.0
OUTCEPTION_AWS_S3_READ_TIMEOUT_SECONDS=20.0
OUTCEPTION_AWS_S3_MAX_ATTEMPTS=3
OUTCEPTION_S3_ENDPOINT_URL=
OUTCEPTION_S3_PUBLIC_ENDPOINT_URL=

# Secrets encryption. Production and sandbox wrap data keys with a KMS key
# (AWS_KMS_KEY_ID); local and CI use a static key instead, so tests make no
# cloud calls.
OUTCEPTION_AWS_KMS_KEY_ID=

# JWKS signing. Production and sandbox sign through a KMS asymmetric key
# (AWS_JWKS_KMS_KEY_ID); elsewhere the key set in JWKS signs in process.
# Without a KMS key, the mounted private key set signs in process (never the
# development set): the file compose mounts, and the key id it was made with.
OUTCEPTION_LOCAL_JWKS=/run/secrets/jwks.json
OUTCEPTION_LOCAL_JWK_KID=
OUTCEPTION_AWS_JWKS_KMS_KEY_ID=
OUTCEPTION_AWS_JWKS_KMS_PUBLISHED_KEY_IDS=[]

# Token hashing. Unset, HASH_SECRETS and CURRENT_HASH_SECRET_ID are read
# instead.
OUTCEPTION_AWS_HASH_SECRET_ARN=

# Application behaviours
OUTCEPTION_API_PAGINATION_MAX_LIMIT=100
OUTCEPTION_API_MAX_REQUEST_BODY_SIZE=10485760
