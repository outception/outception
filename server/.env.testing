OUTCEPTION_POSTGRES_USER="outception"
OUTCEPTION_POSTGRES_PWD="outception"
# A name of its own so the suite never collides with another checkout's test
# databases on the same Postgres.
OUTCEPTION_POSTGRES_DATABASE="outception_rebuild_test"
OUTCEPTION_POSTGRES_PORT="5432"
OUTCEPTION_REDIS_PORT="6379"

OUTCEPTION_CORS_ORIGINS='["http://127.0.0.1:3000", "http://localhost:3000", "http://test"]'
OUTCEPTION_USER_SESSION_COOKIE_DOMAIN="test"

OUTCEPTION_SQLALCHEMY_DEBUG="false"
OUTCEPTION_TESTING=1
