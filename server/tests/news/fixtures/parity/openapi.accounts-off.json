  "/v1/news/crossword": {
   "get": {
    "tags": [
     "news",
     "public"
    ],
    "summary": "Get Crossword",
    "description": "The daily crossword for the wall's puzzle card. One upstream fetch per\nday (Redis-cached); every reader worldwide gets the same puzzle, so the\npayload is fully cacheable at the edge.",
    "operationId": "news:get_crossword",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CrosswordResponse"
        }
       }
      }
     }
    },
    "x-speakeasy-group": "news",
    "x-speakeasy-name-override": "get_crossword"
   }
  },
