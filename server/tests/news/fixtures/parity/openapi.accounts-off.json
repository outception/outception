  "/v1/news/summary/available": {
   "get": {
    "tags": [
     "news",
     "public"
    ],
    "summary": "Get Summary Availability",
    "description": "Cheap pre-check for a headline tap: known-unavailable articles (videos,\npaywalls and bot walls seen before, exhausted budget) answer false in a\nfew milliseconds so the reader is sent to the article immediately rather\nthan after a failed generation.",
    "operationId": "news:get_summary_availability",
    "parameters": [
     {
      "name": "url",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 12,
       "maxLength": 2048,
       "title": "Url"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SummaryAvailability"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "x-speakeasy-group": "news",
    "x-speakeasy-name-override": "get_summary_availability"
   }
  },
  "/v1/news/summary/stream": {
   "get": {
    "tags": [
     "news",
     "public"
    ],
    "summary": "Stream Article Summary",
    "description": "The AI summary as server-sent events, so the panel shows the text as it\nis written: `text` (a whole cached or publisher result), `delta` pieces,\nthen `done` - or `error` when the reader should open the article.",
    "operationId": "news:stream_article_summary",
    "parameters": [
     {
      "name": "url",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 12,
       "maxLength": 2048,
       "title": "Url"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "x-speakeasy-group": "news",
    "x-speakeasy-name-override": "stream_article_summary"
   }
  },
  "/v1/news/summary": {
   "get": {
    "tags": [
     "news",
     "public"
    ],
    "summary": "Get Article Summary",
    "description": "AI summary for a headline tap. One model call per article - everything\nelse is served from cache (and the edge can cache it too).",
    "operationId": "news:get_article_summary",
    "parameters": [
     {
      "name": "url",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 12,
       "maxLength": 2048,
       "title": "Url"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SummaryResponse"
        }
       }
      }
     },
     "502": {
      "description": "Summary unavailable for this article"
     },
     "503": {
      "description": "Summaries not configured"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "x-speakeasy-group": "news",
    "x-speakeasy-name-override": "get_article_summary"
   }
