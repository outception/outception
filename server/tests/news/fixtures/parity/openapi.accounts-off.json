  "/v1/news/weather": {
   "get": {
    "tags": [
     "news",
     "public"
    ],
    "summary": "Get Weather",
    "description": "Current conditions and a short forecast for the reader's location. The\nbrowser sends precise ``latitude``/``longitude`` when geolocation is\ngranted; otherwise it sends the IP ``country`` (from Cloudflare) and we\nresolve that country's capital. Proxied from Open-Meteo, cache-first.\n\nNative clients have no IP-country cookie to read, so when they send neither\ncoordinates nor a country we fall back to Cloudflare's header ourselves -\notherwise a phone whose UI language is US English would be given US weather\nwherever it actually is.",
    "operationId": "news:get_weather",
    "parameters": [
     {
      "name": "latitude",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number",
         "maximum": 90,
         "minimum": -90
        },
        {
         "type": "null"
        }
       ],
       "title": "Latitude"
      }
     },
     {
      "name": "longitude",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number",
         "maximum": 180,
         "minimum": -180
        },
        {
         "type": "null"
        }
       ],
       "title": "Longitude"
      }
     },
     {
      "name": "country",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "minLength": 2,
         "maxLength": 2
        },
        {
         "type": "null"
        }
       ],
       "title": "Country"
      }
     },
     {
      "name": "CF-IPCountry",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Cf-Ipcountry"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/WeatherResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "x-speakeasy-group": "news",
    "x-speakeasy-name-override": "get_weather"
   }
  },
  "/v1/news/heatmap/{heatmap_id}": {
   "get": {
    "tags": [
     "news",
     "public"
    ],
    "summary": "Get Heatmap",
    "description": "Tiles for one market heatmap card (a `type: \"heatmap\"` roster source).\n\nTile area follows `weight` (market cap), color follows `changePercent`.\nServed cache-first with the same success/cache semantics as headline\nsources.",
    "operationId": "news:get_heatmap",
    "parameters": [
     {
      "name": "heatmap_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Heatmap Id"
