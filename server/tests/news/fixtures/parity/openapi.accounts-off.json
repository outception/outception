 "paths": {
  "/v1/news/sources": {
   "get": {
    "tags": [
     "news",
     "public"
    ],
    "summary": "List Sources",
    "description": "Metadata for every known source (including redirect aliases). Pass\n``ids`` (comma-separated) for just those sources - what the wall needs to\npaint its cards without downloading the multi-megabyte roster.",
    "operationId": "news:list_sources",
    "parameters": [
     {
      "name": "ids",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 8192
        },
        {
         "type": "null"
        }
       ],
       "title": "Ids"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/SourceMeta"
         },
         "title": "Response News:List Sources"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "x-speakeasy-group": "news",
    "x-speakeasy-name-override": "list_sources"
   }
  },
  "/v1/news/sources/{source_id}": {
   "get": {
    "tags": [
     "news",
     "public"
    ],
    "summary": "Get Source Meta",
    "description": "Metadata for one source - what a share-card unfurl needs, without\npulling the whole roster.",
    "operationId": "news:get_source_meta",
    "parameters": [
     {
      "name": "source_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Source Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SourceMeta"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "x-speakeasy-group": "news",
    "x-speakeasy-name-override": "get_source_meta"
   }
  },
  "/v1/news/default-deck": {
   "get": {
    "tags": [
     "news",
     "public"
    ],
    "summary": "Default Cards",
    "description": "The default \"Your stack\" seeded for a fresh visitor: one representative\nsource per major category (world, tech, music, culture, weather, sports,\nscience, markets, crypto, betting, gaming). When the reader's ``country``\nis known (Cloudflare IP country), the generic sports sources are swapped for\nthat country's native sports/teams (e.g. Ireland → Gaelic football + hurling,\nUSA → NFL/NBA/MLB). Retired sources are dropped.",
    "operationId": "news:default_deck",
    "deprecated": true,
    "parameters": [
     {
      "name": "country",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "minLength": 2,
         "maxLength": 2
        },
        {
         "type": "null"
        }
       ],
       "title": "Country"
      }
     },
     {
      "name": "CF-IPCountry",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Cf-Ipcountry"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "string"
         },
         "title": "Response News:Default Deck"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "x-speakeasy-group": "news",
    "x-speakeasy-name-override": "default_cards"
   }
  },
