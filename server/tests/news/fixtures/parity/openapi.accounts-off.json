  "/v1/promoted/active": {
   "get": {
    "tags": [
     "promoted",
     "public"
    ],
    "summary": "Get Active Slot",
    "description": "The Promoted card currently running, if any. At most one slot is ever\nactive; the cards renders at most one Promoted card per serve. Cacheable\nfor a short window - a run starting or ending reaches readers within a\nminute, which is plenty for time-boxed runs measured in hours or days.",
    "operationId": "promoted:get_active_slot",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "anyOf": [
          {
           "$ref": "#/components/schemas/PromotedSlot"
          },
          {
           "type": "null"
          }
         ],
         "title": "Response Promoted:Get Active Slot"
        }
       }
      }
     }
    }
   }
  }
 },
