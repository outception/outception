# Development values for the server. `dev up` (or dev/setup-environment)
# copies this file to server/.env, which is never committed. Every name is a
# field of the settings; the production contract is .env.prod.example.

OUTCEPTION_ENV=development
OUTCEPTION_LOG_LEVEL=DEBUG
# Development-only switches (not part of the production contract).
OUTCEPTION_TESTING=0
OUTCEPTION_SQLALCHEMY_DEBUG=0

OUTCEPTION_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "https://github.com"]'
OUTCEPTION_ALLOWED_HOSTS='["localhost:3000", "127.0.0.1:3000"]'
OUTCEPTION_FRONTEND_BASE_URL="http://127.0.0.1:3000"
OUTCEPTION_BASE_URL="http://127.0.0.1:8000"

OUTCEPTION_USER_SESSION_COOKIE_DOMAIN="127.0.0.1"

OUTCEPTION_POSTGRES_USER=outception
OUTCEPTION_POSTGRES_PWD=outception
OUTCEPTION_POSTGRES_HOST=127.0.0.1
OUTCEPTION_POSTGRES_PORT=5432
OUTCEPTION_POSTGRES_DATABASE=outception

OUTCEPTION_POSTGRES_READ_USER=outception_read
OUTCEPTION_POSTGRES_READ_PWD=outception
OUTCEPTION_POSTGRES_READ_HOST=127.0.0.1
OUTCEPTION_POSTGRES_READ_PORT=5432
OUTCEPTION_POSTGRES_READ_DATABASE=outception

OUTCEPTION_REDIS_HOST=127.0.0.1
OUTCEPTION_REDIS_PORT=6379
OUTCEPTION_REDIS_DB=0

# pair (secret + sitekey). Production sets a real secret/sitekey.
# Bot check on email login; empty means off in development.
OUTCEPTION_TURNSTILE_SECRET=

OUTCEPTION_GOOGLE_CLIENT_ID = "*** REPLACE ***"
OUTCEPTION_GOOGLE_CLIENT_SECRET = "*** REPLACE ***"

# Outception self-integration (populated by dev seed)

# Grafana Cloud Prometheus (for local dev with docker compose --profile monitoring)
OUTCEPTION_GRAFANA_CLOUD_PROMETHEUS_WRITE_URL=http://localhost:9090/api/v1/write

OUTCEPTION_APP_REVIEW_EMAIL = "*** REPLACE ***"
OUTCEPTION_APP_REVIEW_OTP_CODE = "*** REPLACE ***"

# Product logos for the daily card; any writable folder in development.
OUTCEPTION_MEDIA_DIR=./media
# Emails allowed on the founder's review pages.
OUTCEPTION_ADMIN_EMAILS=[]
