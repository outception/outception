# Development secrets
# Copy to ~/.config/outception/secrets.env and fill in values.
#
# This file is shared across git worktrees: ./dev/setup-environment merges
# it into server/.env. Nothing here is required for the news wall itself;
# each block switches one feature on.

# Social login (a provider is enabled when both values are set)
OUTCEPTION_GOOGLE_CLIENT_ID=
OUTCEPTION_GOOGLE_CLIENT_SECRET=
OUTCEPTION_MICROSOFT_CLIENT_ID=
OUTCEPTION_MICROSOFT_CLIENT_SECRET=
OUTCEPTION_APPLE_CLIENT_ID=
OUTCEPTION_APPLE_TEAM_ID=
OUTCEPTION_APPLE_KEY_ID=
OUTCEPTION_APPLE_KEY_VALUE=

# Model lanes for summaries and decisions (comma-separate several keys)
OUTCEPTION_GEMINI_API_KEYS=
OUTCEPTION_GROQ_API_KEYS=
OUTCEPTION_ANTHROPIC_API_KEY=

# Table providers that need a free registration
OUTCEPTION_FINNHUB_API_KEY=
OUTCEPTION_FOOTBALL_DATA_API_KEY=
OUTCEPTION_CRICKETDATA_API_KEY=

# The house decision model, when its container runs locally
OUTCEPTION_ENGINE_URL=
OUTCEPTION_ENGINE_API_KEY=
